{
  "name": "win95-classic",
  "displayName": "Windows 95 Classic",
  "description": "Windows 95 inspired color and file icon themes using official VS Code APIs.",
  "version": "1.3.2",
  "publisher": "max-local",
  "license": "MIT",
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "Themes"
  ],
  "contributes": {
    "themes": [
      {
        "label": "Windows 95 Classic",
        "uiTheme": "vs",
        "path": "./themes/windows95.json"
      }
    ],
    "iconThemes": [
      {
        "id": "win95-classic-icons",
        "label": "Windows 95 Classic Icons",
        "path": "./icons/windows95-icon-theme.json"
      }
    ]
  },
  "scripts": {
    "build": "vsce package --no-dependencies --allow-missing-repository -o artifacts/windows95-classic-1.3.2.vsix",
    "test": "node --test tests/*.test.cjs"
  },
  "devDependencies": {
    "@vscode/vsce": "^4.0.0",
    "sharp": "^0.35.5",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  },
  "icon": "assets/extension-icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Multsev/win95-vscode-theme.git"
  },
  "homepage": "https://github.com/Multsev/win95-vscode-theme#readme",
  "bugs": {
    "url": "https://github.com/Multsev/win95-vscode-theme/issues"
  }
}
