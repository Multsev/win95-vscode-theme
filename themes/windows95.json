  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#555555"
      }
    },
    {
      "scope": [
        "keyword",
        "storage",
        "entity.name.type"
      ],
      "settings": {
        "foreground": "#000080"
      }
    },
    {
      "scope": [
        "string"
      ],
      "settings": {
        "foreground": "#006000"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language"
      ],
      "settings": {
        "foreground": "#800000"
      }
    },
    {
      "scope": [
        "entity.name.function"
      ],
      "settings": {
        "foreground": "#000000"
      }
    },
    {
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "foreground": "#000080",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#000080"
      }
    },
    {
      "scope": [
        "variable.parameter",
        "variable.other.property",
        "support.variable.property"
      ],
      "settings": {
        "foreground": "#333333"
      }
    },
    {
      "scope": [
        "support.function",
        "entity.name.function"
      ],
      "settings": {
        "foreground": "#303060"
      }
    },
    {
      "scope": [
        "constant.character.escape",
        "constant.other.symbol"
      ],
      "settings": {
        "foreground": "#660066"
      }
    },
    {
      "scope": [
        "support.type.property-name.json",
        "meta.object-literal.key",
        "entity.name.tag.yaml"
      ],
      "settings": {
        "foreground": "#000080"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#000080"
      }
    },
    {
      "scope": [
        "markup.heading",
        "entity.name.section.markdown"
      ],
      "settings": {
        "foreground": "#000080",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.underline.link.markdown",
        "markup.underline.link.image.markdown"
      ],
      "settings": {
        "foreground": "#000080",
        "fontStyle": "underline"
      }
    },
    {
      "scope": [
        "markup.inline.raw",
        "markup.raw.block.markdown"
      ],
      "settings": {
        "foreground": "#800000"
      }
    },
    {
      "scope": [
        "punctuation.definition.list.begin.markdown",
        "markup.list"
      ],
      "settings": {
        "foreground": "#333333"
      }
    },
    {
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#555555"
      }
    },
    {
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#006000"
      }
    },
    {
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#800000"
      }
    },
    {
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#000080"
      }
    }
  ],
  "semanticTokenColors": {
    "comment": "#555555",
    "keyword": "#000080",
    "string": "#006000",
    "number": "#800000",
    "type": "#000080",
    "function": "#303060",
    "class": "#000080",
    "interface": "#000080",
    "enum": "#000080",
    "typeParameter": "#000080",
    "namespace": "#000080",
    "parameter": "#333333",
    "property": "#333333",
    "method": "#303060",
    "enumMember": "#800000",
    "variable.readonly": "#660066",
    "variable.defaultLibrary": "#000080"
  }
}
